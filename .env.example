# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.

# Dirección completa donde se abre la herramienta.
#   Servidor:     https://redes.alexisconsultor.com
#   Computadora:  http://localhost:3010
POSTIZ_URL=https://redes.alexisconsultor.com

# Puerto interno (solo dentro del servidor). Debe coincidir con la plantilla de proxy
# de Hestia: NODEJS3010 manda redes.alexisconsultor.com a 127.0.0.1:3010.
# (El 3003 lo ocupa el sitio de otro usuario del servidor: no lo uses.)
POSTIZ_PORT=3010

# Déjalo vacío en el servidor. Ponlo en true SOLO para probar en tu computadora
# (permite iniciar sesión sin HTTPS).
NOT_SECURED=

# Versión de la imagen de Postiz. Va fija para que no se actualice sola; para subir de
# versión, cámbiala aquí (ver https://github.com/gitroomhq/postiz-app/releases).
POSTIZ_VERSION=v2.25.1

# Secretos: genera cada uno con  openssl rand -hex 32
JWT_SECRET=cambia-esto
POSTGRES_PASSWORD=cambia-esto
TEMPORAL_DB_PASSWORD=cambia-esto

# SEGURIDAD: mientras esté en false, cualquiera que abra la dirección puede crear
# una cuenta. Crea tu usuario (y los del equipo) en cuanto arranque y cámbialo a true
# para que nadie más pueda registrarse.
DISABLE_REGISTRATION=false

# === Meta ===
# App de developers.facebook.com para Facebook e Instagram (vía página de FB)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# App de Instagram con "Instagram Login" (cuentas sin página de Facebook)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# === Otras redes (opcional, para más adelante) ===
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# === IA para redactar copys (opcional) ===
OPENAI_API_KEY=

# === Correo (opcional) ===
# Para invitar al equipo por correo y recuperar contraseñas. Si lo dejas vacío,
# Postiz no manda correos y las cuentas nuevas se activan solas.
# Con el buzón estrategias@ de Hestia: EMAIL_PROVIDER=nodemailer,
# EMAIL_HOST=mail.alexisconsultor.com, EMAIL_PORT=465, EMAIL_SECURE=true.
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Prisma CN · Redes
EMAIL_FROM_ADDRESS=
