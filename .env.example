# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.

# Subdominio donde vivirá la herramienta (sin https://).
# Debe tener un registro DNS tipo A apuntando a la IP del servidor.
# Para probar en tu computadora usa: localhost
POSTIZ_DOMAIN=social.tudominio.com

# Versión de la imagen de Postiz. "latest" para probar; en producción fija una
# versión concreta (ver https://github.com/gitroomhq/postiz-app/releases).
POSTIZ_VERSION=latest

# Secretos: genera cada uno con  openssl rand -hex 32
JWT_SECRET=cambia-esto
POSTGRES_PASSWORD=cambia-esto
TEMPORAL_DB_PASSWORD=cambia-esto

# Después de crear tu usuario (y los de tu equipo), cámbialo a true
# para que nadie más pueda registrarse.
DISABLE_REGISTRATION=false

# === Meta ===
# App de developers.facebook.com para Facebook e Instagram (vía página de FB)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# App de Instagram con "Instagram Login" (cuentas sin página de Facebook)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# === Otras redes (opcional, para más adelante) ===
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# === IA para redactar copys (opcional) ===
OPENAI_API_KEY=
